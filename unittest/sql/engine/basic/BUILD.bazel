load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:defs.bzl", "cc_library")
load("//bazel:compile_config.bzl", "MODULE_CXX_COPTS")

package(default_testonly = True)

cc_library(
    name = "file_scan_utils_cases",
    srcs = [
        "test_file_scan_utils.cpp",
        "//src/sql:engine/basic/ob_file_parquet_scan.cpp",
        "//src/sql:engine/basic/ob_file_scan_utils.cpp",
    ],
    hdrs = glob(
        ["data/*.h"],
        allow_empty = True,
    ) + [
        "//src/sql:engine/basic/ob_file_parquet_scan.h",
        "//src/sql:engine/basic/ob_file_scan_utils.h",
    ],
    alwayslink = True,
    copts = MODULE_CXX_COPTS,
    deps = ["//bazel/third_party:gtest"],
)

cc_test(
    name = "test_file_scan_utils",
    srcs = ["test_main.cpp"],
    linkstatic = True,
    deps = [
        ":file_scan_utils_cases",
        "//src/oblib:oblib_test_runtime",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)
