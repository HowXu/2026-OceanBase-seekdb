# owner: database-competition
# description: Cached file scans recheck policy and identities on every execution.
--disable_query_log
let $SECURITY_TOKEN = query_get_value("select connection_id() as token",token,1);
let $SECURITY_DIR = $OBSERVER_DIR/file_sql_security_$SECURITY_TOKEN;
exec mkdir -p "$SECURITY_DIR/denied";
--write_file $SECURITY_DIR/input.csv
id,name
1,one
EOF
set session enable_file_sql=ON;
eval prepare file_sql_identity from "select name from read_csv('$SECURITY_DIR/input.csv')";
--echo # initial prepared execution
execute file_sql_identity;
--echo # replacement with the same size and mtime invalidates the old definition
exec python3 -c "import os; from pathlib import Path; p=Path('$SECURITY_DIR/input.csv'); s=p.stat(); q=p.with_suffix('.new'); q.write_text('id,name'+chr(10)+'1,two'+chr(10)); os.utime(q,ns=(s.st_atime_ns,s.st_mtime_ns)); os.replace(q,p)";
--replace_result $SECURITY_DIR [SECURITY_DIR]
--error 4016
execute file_sql_identity;
deallocate prepare file_sql_identity;
# Use a distinct SQL cache key: DEALLOCATE does not evict a shared cached plan.
eval prepare file_sql_policy from "select name as current_name from read_csv('$SECURITY_DIR/input.csv')";
--echo # a fresh SQL plan observes the new file
execute file_sql_policy;
--echo # a cached plan cannot bypass the current feature switch
set session enable_file_sql=OFF;
--error 1235
execute file_sql_policy;
set session enable_file_sql=ON;
eval prepare file_sql_copy_policy from "copy (select 1 as id) to '$SECURITY_DIR/copy.csv'";
execute file_sql_copy_policy;
remove_file $SECURITY_DIR/copy.csv;
--disable_result_log
eval describe select * from read_csv('$SECURITY_DIR/input.csv');
--enable_result_log
--echo # a cached plan cannot retain a previous secure_file_priv grant
connect (file_sql_policy_admin,localhost,root,,test,$OBMYSQL_PORT,$OBSERVER_DIR/run/sql.sock);
connection file_sql_policy_admin;
let $OLD_FILE_SQL_ROOT = query_get_value("select @@global.secure_file_priv as root",root,1);
eval set global secure_file_priv='$SECURITY_DIR/denied';
connection default;
--error 1227
execute file_sql_policy;
--echo # fresh metadata and COPY cannot use the stale session root either
--error 1227
eval describe select * from read_csv('$SECURITY_DIR/input.csv');
--error 1227
execute file_sql_copy_policy;
--error 1227
eval copy (select 2 as id) to '$SECURITY_DIR/fresh.csv';
connection file_sql_policy_admin;
eval set global secure_file_priv='$OLD_FILE_SQL_ROOT';
connection default;
--echo # restoring policy permits the unchanged prepared definition
execute file_sql_policy;
execute file_sql_copy_policy;
deallocate prepare file_sql_policy;
deallocate prepare file_sql_copy_policy;
remove_file $SECURITY_DIR/copy.csv;
--echo # revocation while COPY is active prevents publication and cleans the temp inode
send_eval copy (select sleep(2) as waited) to '$SECURITY_DIR/revoked.csv';
exec python3 -c "import time,sys; from pathlib import Path; p=Path('$SECURITY_DIR'); found=any(bool(list(p.glob('.seekdb-copy-*'))) or time.sleep(0.01) for _ in range(100)); sys.exit(0 if found else 1)";
connection file_sql_policy_admin;
eval set global secure_file_priv='$SECURITY_DIR/denied';
connection default;
--error 1227
reap;
exec python3 -c "from pathlib import Path; p=Path('$SECURITY_DIR'); assert not (p/'revoked.csv').exists() and not list(p.glob('.seekdb-copy-*'))";
connection file_sql_policy_admin;
eval set global secure_file_priv='$OLD_FILE_SQL_ROOT';
disconnect file_sql_policy_admin;
connection default;
set session enable_file_sql=OFF;
remove_file $SECURITY_DIR/input.csv;
exec rmdir "$SECURITY_DIR/denied" "$SECURITY_DIR";
--enable_query_log
